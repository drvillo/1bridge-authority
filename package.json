{
  "name": "@drvillo/1bridge-authority",
  "version": "0.1.0",
  "description": "Workspace-scoped authenticated authority and nonblocking governance evidence",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvillo/1bridge-authority.git"
  },
  "homepage": "https://github.com/drvillo/1bridge-authority#readme",
  "bugs": "https://github.com/drvillo/1bridge-authority/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/blind-proof-access-server.d.ts",
      "node": {
        "import": "./dist/blind-proof-access-server.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build",
    "publish:npm": "npm publish"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
